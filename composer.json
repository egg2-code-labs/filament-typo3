{
    "name": "egg2-code-labs/filament-typo3",
    "description": "Bring some Typo3 functions to Filament PHP.",
    "type": "library",
    "version": "1.0.3",
    "license": "MIT",
    "require": {
        "filament/filament": "^5.0",
        "spatie/laravel-package-tools": "^1.16",
        "livewire/livewire": "^4.0"
    },
    "require-dev": {
        "laravel/pint": "^1.14",
        "nunomaduro/collision": "^8.1.1||^7.10.0",
        "larastan/larastan": "^3.10.0",
        "orchestra/testbench": "^11.1.0",
        "pestphp/pest": "^4.7.5",
        "pestphp/pest-plugin-arch": "^4.0.2",
        "pestphp/pest-plugin-laravel": "^4.1.0",
        "phpstan/extension-installer": "^1.3",
        "phpstan/phpstan-deprecation-rules": "^2.0.4",
        "phpstan/phpstan-phpunit": "^2.0.18",
        "pestphp/pest-plugin-livewire": "^4.1.0"
    },
    "scripts": {
        "test": "./vendor/bin/pest ./tests"
    },
    "autoload": {
        "psr-4": {
            "Egg2CodeLabs\\FilamentTypo3\\": "src/",
            "Egg2CodeLabs\\FilamentTypo3\\Tests\\": "tests/"
        }
    },
    "authors": [
        {
            "name": "Alexander Hofbauer",
            "email": "alex@eggsquare.net"
        }
    ],
    "minimum-stability": "stable",
    "extra": {
        "laravel": {
            "providers": [
                "Egg2CodeLabs\\FilamentTypo3\\FilamentTypo3ServiceProvider"
            ]
        }
    },
    "config": {
        "allow-plugins": {
            "pestphp/pest-plugin": true,
            "phpstan/extension-installer": true
        }
    }
}
